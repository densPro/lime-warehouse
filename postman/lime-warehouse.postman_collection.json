{
  "info": {
    "name": "lime-warehouse",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login to mango-auth",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/v1/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"app\": \"erp\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Create item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"MANGO-{{runId}}\",\n  \"name\": \"Mango, 10 kg case\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('itemId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create bin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/locations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"A-{{runId}}\",\n  \"zone\": \"ambient\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('binId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find receiving dock",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/locations?zone=dock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations"
              ],
              "query": [
                {
                  "key": "zone",
                  "value": "dock"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('recvId', j.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create purchase order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/purchase-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "purchase-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"po_number\": \"PO-{{runId}}\",\n  \"supplier\": \"Tropico\",\n  \"lines\": [\n    {\n      \"item_id\": \"{{itemId}}\",\n      \"ordered_qty\": 100\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('poId', j.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Receiving",
      "item": [
        {
          "name": "Receive 80 of 100 (short)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/goods-receipts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "goods-receipts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchase_order_id\": \"{{poId}}\",\n  \"lines\": [\n    {\n      \"item_id\": \"{{itemId}}\",\n      \"received_qty\": 80\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('flagged short', () => pm.expect(j.lines[0].discrepancy).to.eql('short'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Receipts with discrepancies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/goods-receipts?has_discrepancy=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "goods-receipts"
              ],
              "query": [
                {
                  "key": "has_discrepancy",
                  "value": "true"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Put-away",
      "item": [
        {
          "name": "Put 80 into the bin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/putaways",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "putaways"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": \"{{itemId}}\",\n  \"from_location_id\": \"{{recvId}}\",\n  \"to_location_id\": \"{{binId}}\",\n  \"quantity\": 80\n}"
            }
          }
        },
        {
          "name": "Too many (409 insufficient_stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/putaways",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "putaways"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": \"{{itemId}}\",\n  \"from_location_id\": \"{{recvId}}\",\n  \"to_location_id\": \"{{binId}}\",\n  \"quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock levels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock-levels?item_id={{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stock-levels"
              ],
              "query": [
                {
                  "key": "item_id",
                  "value": "{{itemId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Picking",
      "item": [
        {
          "name": "Create pick list",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pick-lists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pick-lists"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"SO-{{runId}}\",\n  \"lines\": [\n    {\n      \"item_id\": \"{{itemId}}\",\n      \"location_id\": \"{{binId}}\",\n      \"quantity\": 10\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('pickListId', j.id);",
                  "pm.collectionVariables.set('pickLineId', j.lines[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm pick",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pick-lists/{{pickListId}}/lines/{{pickLineId}}/picks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pick-lists",
                "{{pickListId}}",
                "lines",
                "{{pickLineId}}",
                "picks"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Stock count",
      "item": [
        {
          "name": "Open count on the bin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock-counts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stock-counts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location_id\": \"{{binId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('countId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Record counted quantity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock-counts/{{countId}}/lines",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stock-counts",
                "{{countId}}",
                "lines"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lines\": [\n    {\n      \"item_id\": \"{{itemId}}\",\n      \"counted_qty\": 68\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Submit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock-counts/{{countId}}/submission",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stock-counts",
                "{{countId}}",
                "submission"
              ]
            }
          }
        },
        {
          "name": "Approve (needs stock:adjust)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock-counts/{{countId}}/approval",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stock-counts",
                "{{countId}}",
                "approval"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Recount found 2 damaged cases\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "6. Audit trail",
      "item": [
        {
          "name": "All movements for the item",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock-movements?item_id={{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stock-movements"
              ],
              "query": [
                {
                  "key": "item_id",
                  "value": "{{itemId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8004"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:8003"
    },
    {
      "key": "email",
      "value": "admin@example.com"
    },
    {
      "key": "password",
      "value": "change-me-now"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "runId",
      "value": "1"
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "binId",
      "value": ""
    },
    {
      "key": "recvId",
      "value": ""
    },
    {
      "key": "poId",
      "value": ""
    },
    {
      "key": "pickListId",
      "value": ""
    },
    {
      "key": "pickLineId",
      "value": ""
    },
    {
      "key": "countId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// one id per collection run keeps SKUs, bin codes and PO numbers unique",
          "if (pm.info.requestName === 'Login to mango-auth') { pm.collectionVariables.set('runId', Date.now().toString().slice(-8)); }"
        ]
      }
    }
  ]
}

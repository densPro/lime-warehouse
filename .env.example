DATABASE_URL=postgresql+asyncpg://lime:lime@db:5436/lime_warehouse
# mango-auth service and the app name its tokens are issued for (token `aud`)
MANGO_AUTH_URL=http://host.docker.internal:8003
MANGO_AUTH_APP=erp
# Seconds a permission change can take to reach this service (0 = ask mango-auth on every request)
PERMISSION_TTL=10
LOG_LEVEL=INFO
# true = one JSON object per log line, false = readable text for local development
LOG_JSON=true
# Sample data loaded on every start: fruits, vegetables or computers. Leave empty to load none.
SEED_DEMO=
